#!/bin/sh

if [ "${WI_AUTO_INSTALL:-1}" = "0" ]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
"$root/scripts/install-local" --clean --quiet
status=$?
case "$status" in
    0)
        echo "post-commit: installed wi from $(git rev-parse --short=12 HEAD)"
        ;;
    3)
        echo "post-commit: skipped wi auto-install because the checkout still has uncommitted changes" >&2
        ;;
    *)
        echo "post-commit: wi auto-install failed (exit $status); commit remains successful" >&2
        ;;
esac
exit 0
